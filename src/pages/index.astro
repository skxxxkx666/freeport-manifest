---
import Shell from "../components/Shell.astro";
import Stamp from "../components/Stamp.astro";
import TearLine from "../components/TearLine.astro";
import CompareTable from "../components/CompareTable.astro";
import PlanCards from "../components/PlanCards.astro";
import { latestSub } from "../lib/subs";
import { FAQ } from "../lib/faq";
import { url, waybillNo } from "../lib/waybill";

const sub = await latestSub();
if (!sub) throw new Error("没有任何运单,先跑 scripts/issue-manifest.mjs");
const d = sub.data;
const no = waybillNo(d.date, d.serial);

const wbType =
  "font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:clamp(30px,7.4cqw,60px);letter-spacing:-.02em;line-height:1;white-space:nowrap";
const label = "font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#A9A3B2;text-transform:uppercase";
const cellLabel = "font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.12em;color:#A9A3B2;text-transform:uppercase;margin-bottom:8px";
const cell = "flex:1 1 150px;min-width:0;padding:12px 13px 14px;border-right:1px solid #C9C2CE;border-bottom:1px solid #C9C2CE";
const stepCell = "flex:1 1 210px;min-width:0;padding:14px 14px 12px;display:flex;flex-direction:column;gap:8px;min-height:132px;border-right:1px solid #C9C2CE;border-bottom:1px solid #C9C2CE";
const stepLink = "margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.1em;color:#2A2333;border-top:1px solid #C9C2CE;padding-top:9px";
const btnPrimary = "border:1px solid #2A2333;background:#2A2333;color:#FBFAF7;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.1em;padding:13px 22px;text-transform:uppercase";
const btnGhost = "border:1px solid #2A2333;background:transparent;color:#2A2333;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.1em;padding:13px 22px;text-transform:uppercase";
const h2 = "margin:0 0 14px;font-family:'Smiley Sans','Archivo Narrow','PingFang SC',sans-serif;font-weight:700;font-size:23px;letter-spacing:.04em";

const steps = [
  { n: "01", t: "复制订阅", d: "在今日舱单页取一条订阅链接,Clash 与 V2Ray 各一联。", href: url("today"), cta: "→ /TODAY", ext: false },
  { n: "02", t: "打开客户端", d: "Clash Verge Rev、Shadowrocket、v2rayN 等,按平台选一个。", href: "https://wiki.freedomport.cc/", cta: "WIKI.FREEDOMPORT.CC ↗", ext: true },
  { n: "03", t: "导入并选择节点", d: "粘贴链接更新配置,挑一个延迟低的节点开始使用。", href: "https://wiki.freedomport.cc/", cta: "WIKI.FREEDOMPORT.CC ↗", ext: true }
];
---
<Shell
  title="免费 Clash 与 V2Ray 订阅"
  description="舱单 MANIFEST 每 12 小时聚合公开免费节点，经 Mihomo 连通性与延迟测试后发布 Clash、Mihomo、V2Ray 订阅，无需注册。"
  schema={{
    about: [
      { "@type": "Thing", name: "Clash 订阅" },
      { "@type": "Thing", name: "Mihomo 节点" },
      { "@type": "Thing", name: "V2Ray 订阅" }
    ]
  }}
>
  <div>
    <div data-rise style="padding:34px 20px 26px;border-bottom:1px solid #C9C2CE">
      <div style="display:flex;flex-wrap:wrap;gap:26px;align-items:flex-start;justify-content:space-between">
        <div style="flex:1 1 300px;min-width:0">
          <div style={label + ";margin-bottom:6px"}>WAYBILL NO. / 运单号</div>
          <div style="position:relative;margin-bottom:14px">
            <div aria-hidden="true" style={`position:absolute;left:0;top:0;transform:translate(1.5px,1.5px);opacity:.18;color:#2C6E7A;pointer-events:none;${wbType}`}>{no}</div>
            <div style={`position:relative;${wbType}`}>{no}</div>
          </div>

          <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:4px">
            <h1 style="margin:0;font-family:'Smiley Sans','Archivo Narrow','PingFang SC',sans-serif;font-weight:700;font-size:clamp(30px,6vw,42px);letter-spacing:.04em;line-height:1.05">舱单</h1>
            <span style="font-size:14px;color:#6B6478;letter-spacing:.06em">自由港每日放行清单</span>
          </div>
          <p style="margin:10px 0 20px;max-width:38em;font-size:15px;line-height:1.75;color:#2A2333;text-wrap:pretty">
            每 12 小时更新免费 Clash、Mihomo 与 V2Ray 订阅。公开来源聚合并经过连通性实测,随取随用,不需要注册。
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:10px">
            <a href={url("today")} style={btnPrimary}>领取今日订阅 <span style="opacity:.55">/TODAY</span></a>
            <a href={url("archive")} style={btnGhost}>查看往期 <span style="color:#6B6478">/ARCHIVE</span></a>
          </div>
        </div>

        <div style="flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:8px;padding-top:6px">
          <Stamp size={132} date={d.date} rotate={-5} />
          <div style="font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:.16em;color:#A9A3B2;text-transform:uppercase">ISSUED / 今日已更新</div>
        </div>
      </div>

      <div style="margin-top:24px;border:1px solid #C9C2CE;border-left:3px solid #7B3F9D;background:#F6F4EF;padding:11px 14px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;line-height:1.7;letter-spacing:.02em;color:#2A2333">
        免费节点来自公开来源,随时可能失效或降速,不提供任何可用性保障。
      </div>
    </div>

    <div data-rise style="padding:22px 20px 26px;border-bottom:1px solid #C9C2CE">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#A9A3B2;text-transform:uppercase;margin-bottom:12px">SUMMARY / 今日概况</div>
      <div style="display:flex;flex-wrap:wrap;border-top:1px solid #C9C2CE;border-left:1px solid #C9C2CE">
        <div style={cell}>
          <div style={cellLabel}>ISSUED / 签发时间</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:19px;letter-spacing:-.01em">{d.issuedAt.slice(11, 16)} <span style="font-size:11px;color:#6B6478">UTC+8</span></div>
        </div>
        <div style={cell}>
          <div style={cellLabel}>PIECES / 节点件数</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:19px;letter-spacing:-.01em">{d.nodeCount} <span style="font-size:11px;color:#6B6478">PCS</span></div>
        </div>
        <div style={cell}>
          <div style={cellLabel}>ORIGIN / 覆盖地区</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:19px;letter-spacing:.02em">{d.regions.join(" ")}</div>
        </div>
        <div style={cell}>
          <div style={cellLabel}>COMMODITY / 协议</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:13.5px;line-height:1.5;letter-spacing:.02em">{d.protocols.join(" ")}</div>
        </div>
      </div>
    </div>

    <div data-rise style="padding:22px 20px 26px;border-bottom:1px solid #C9C2CE">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#A9A3B2;text-transform:uppercase;margin-bottom:12px">PROCEDURE / 怎么用</div>
      <div style="display:flex;flex-wrap:wrap;border-top:1px solid #C9C2CE;border-left:1px solid #C9C2CE">
        {steps.map((s) => (
          <div style={stepCell}>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:26px;font-weight:600;color:#7B3F9D;line-height:1">{s.n}</div>
            <div style="font-family:'Smiley Sans','Archivo Narrow','PingFang SC',sans-serif;font-weight:600;font-size:19px;letter-spacing:.03em">{s.t}</div>
            <p style="margin:0;font-size:14px;line-height:1.7;color:#6B6478">{s.d}</p>
            <a href={s.href} style={stepLink} target={s.ext ? "_blank" : undefined} rel={s.ext ? "noopener" : undefined}>{s.cta}</a>
          </div>
        ))}
      </div>
    </div>

    <div data-rise><TearLine /></div>

    <div data-rise style="padding:6px 20px 28px">
      <div style={label + ";margin-bottom:6px"}>COMPARISON / 两联对照</div>
      <h2 style={h2}>免费联 vs 登机联</h2>
      <CompareTable />
      <div style="margin-top:9px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.06em;color:#6B6478">线路覆盖:香港 / 新加坡 / 日本 / 美国</div>
    </div>

    <div data-rise style="padding:0 20px 30px">
      <div style={label + ";margin-bottom:6px"}>FARES / 套餐速览</div>
      <h2 style={h2}>四档舱位</h2>
      <PlanCards />
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:14px">
        <a href="https://cn.freedomport.cc" target="_blank" rel="noopener" style="border:1px solid #1258D8;background:#1258D8;color:#FBFAF7;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.1em;padding:13px 22px;text-transform:uppercase">前往自由港官网 ↗</a>
        <a href="https://t.me/FreedomPort1" target="_blank" rel="noopener" style="border:1px solid #1258D8;background:transparent;color:#1258D8;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.1em;padding:13px 22px;text-transform:uppercase">加入 TELEGRAM 群组</a>
      </div>
    </div>

    <div data-rise style="padding:0 20px 30px">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#A9A3B2;text-transform:uppercase;margin-bottom:12px">FAQ / 常见问题(前三条)</div>
      <div style="border:1px solid #C9C2CE">
        {FAQ.slice(0, 3).map(([q, a], i) => (
          <div style={`padding:13px 14px${i < 2 ? ";border-bottom:1px solid #C9C2CE" : ""}`}>
            <div style="font-family:'Smiley Sans','Archivo Narrow','PingFang SC',sans-serif;font-weight:600;font-size:16px;letter-spacing:.02em;margin-bottom:6px">{q}</div>
            <p style="margin:0;font-size:14px;line-height:1.7;color:#6B6478">{a}</p>
          </div>
        ))}
      </div>
      <a href={url("faq")} style="display:inline-block;margin-top:10px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.1em;color:#2A2333">→ 查看完整 FAQ /FAQ</a>
    </div>
  </div>
</Shell>
