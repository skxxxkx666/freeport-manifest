---
import Shell from "../components/Shell.astro";
import Stamp from "../components/Stamp.astro";
import TearLine from "../components/TearLine.astro";
import SubscriptionCard from "../components/SubscriptionCard.astro";
import UpdateCountdown from "../components/UpdateCountdown.astro";
import RegionMark from "../components/RegionMark.astro";
import { latestSub, checkCode, remarkOf } from "../lib/subs";
import { chinaDateTime, url, waybillNo } from "../lib/waybill";

const sub = await latestSub();
if (!sub) throw new Error("没有任何运单");
const d = sub.data;
const no = waybillNo(d.date, d.serial);

const wbType =
  "font-family:var(--font-mono);font-weight:600;font-size:clamp(28px,4.2cqw,56px);letter-spacing:-.02em;line-height:1;white-space:nowrap";
const miniLabel = "font-family:var(--font-mono);font-size:9.5px;letter-spacing:.12em;color:var(--color-ink-faint);text-transform:uppercase;margin-bottom:5px";
const breakdown = d.breakdown ?? [];
const regionBreakdown = [...new Set(breakdown.map((row) => row.region))].map((region) => {
  const protocols = breakdown.filter((row) => row.region === region);
  return {
    region,
    protocols,
    total: protocols.reduce((sum, row) => sum + row.count, 0)
  };
});
---
<Shell
  title="今日免费 Clash 与 V2Ray 订阅"
  description={`领取今日免费 Clash、Mihomo 与 V2Ray 订阅：${d.nodeCount} 个发布前实测节点，覆盖 ${d.regions.join("、")}，每 12 小时更新。`}
  schema={{
    dateModified: d.testedAt ?? d.issuedAt,
    about: [
      { "@type": "Thing", name: "免费 Clash 订阅" },
      { "@type": "Thing", name: "免费 V2Ray 节点" }
    ]
  }}
>
  <div>
    <div style="padding:26px 20px 20px;border-bottom:1px solid var(--color-rule)">
      <div class="wb-hero">
        <div style="min-width:0">
          <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;color:var(--color-ink-faint);text-transform:uppercase;margin-bottom:6px">WAYBILL NO. / 运单号</div>
          <div style="position:relative;margin-bottom:10px">
            <div aria-hidden="true" style={`position:absolute;left:0;top:0;transform:translate(1.5px,1.5px);opacity:.18;color:var(--color-misprint);pointer-events:none;${wbType}`}>{no}</div>
            {/* 运单号就是这一页的标题 —— 此前整页没有 h1 */}
            <h1 style={`position:relative;margin:0;${wbType}`}>{no}</h1>
          </div>
          <div style="display:flex;flex-wrap:wrap;border-top:1px solid var(--color-rule);border-left:1px solid var(--color-rule);max-width:520px">
            <div style="flex:1 1 150px;min-width:0;padding:9px 11px;border-right:1px solid var(--color-rule);border-bottom:1px solid var(--color-rule)">
              <div style={miniLabel}>ISSUED / 签发时间</div>
              <div style="font-family:var(--font-mono);font-size:14px">{chinaDateTime(d.issuedAt)}</div>
            </div>
            <div style="flex:1 1 150px;min-width:0;padding:9px 11px;border-right:1px solid var(--color-rule);border-bottom:1px solid var(--color-rule)">
              <div style={miniLabel}>NEXT ISSUE / 下次更新</div>
              <UpdateCountdown />
            </div>
          </div>
        </div>
        <Stamp size={108} date={d.date} rotate={-6} />
      </div>
    </div>

    <div>
      <SubscriptionCard
        clash={d.clash}
        v2ray={d.v2ray}
        nodeCount={d.nodeCount}
        regions={d.regions}
        protocols={d.protocols}
        checkCode={checkCode(d.date, d.serial)}
        remark={remarkOf(d)}
        date={d.date}
        revealSeconds={3}
      />
    </div>

    {/* 明细区块无论有没有数据都要在。此前为空时整块消失,而上方的
        PIECES / 件数 仍然显示着数字 —— 用户看到一个件数却找不到明细,
        既没有解释也不知道是不是页面坏了。 */}
    <div style="padding:20px;border-bottom:1px solid var(--color-rule)">
      <div class="wb-breakdown-heading">
        <h2>BREAKDOWN / 地区放行簿</h2>
        {breakdown.length > 0 && (
          <span>{regionBreakdown.length} REGIONS · {breakdown.length} ENTRIES</span>
        )}
      </div>
      {breakdown.length === 0 && (
        <div style="width:100%;border:1px solid var(--color-rule);background:var(--color-notice);padding:14px;font-family:var(--font-mono);font-size:12px;line-height:1.7;letter-spacing:.02em;color:var(--color-ink-soft)">
          本次签发未附地区与协议明细。上方的件数与订阅链接不受影响,可以正常取用。
        </div>
      )}
      {breakdown.length > 0 && (
        <div class="wb-breakdown-board">
          <ul class="wb-breakdown-grid" aria-label="按来源地区汇总的节点协议与数量">
            {regionBreakdown.map((group) => (
              <li class="wb-breakdown-region">
                <RegionMark code={group.region} />
                <ul
                  class="wb-region-protocols"
                  aria-label={`${group.region} 协议构成`}
                >
                  {group.protocols.map((row) => (
                    <li>
                      <span>{row.protocol}</span>
                      <data value={row.count}>{row.count}</data>
                    </li>
                  ))}
                </ul>
                <div
                  class="wb-region-total"
                  aria-label={`${group.region} 合计 ${group.total} 个节点`}
                >
                  <strong>{group.total}</strong>
                  <span>PCS</span>
                </div>
              </li>
            ))}
          </ul>
          <div class="wb-breakdown-total">
            <span>TOTAL RELEASED / 已放行总数</span>
            <strong>{d.nodeCount} <small>PCS</small></strong>
          </div>
        </div>
        <p class="wb-breakdown-note">
          国旗按节点名称中的地区标签识别，仅用于快速区分来源，不代表 IP 定位或实际出口位置。
        </p>
      )}
    </div>

    <div><TearLine /></div>

    <div style="padding:4px 20px 30px">
      <div style="border:1px solid var(--color-rule);padding:16px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between">
        <div style="flex:1 1 260px;min-width:0">
          <h2 style="margin:0 0 7px;font-family:var(--font-mono);font-size:10px;font-weight:400;letter-spacing:.14em;color:var(--color-port-blue);text-transform:uppercase">BOARDING PASS / 登机联</h2>
          <p style="margin:0;font-size:14px;line-height:1.7;color:var(--color-ink);text-wrap:pretty">
            免费联够用,但线路混杂、随时失效;要稳定的 CN2 / 9929 / CMI 与流媒体、AI 应用,登机联从 ¥9.90 起。
          </p>
        </div>
        <a href={url("upgrade")} class="wb-btn-port" style="flex:0 0 auto;border:1px solid var(--color-port-blue);background:var(--color-port-blue);color:var(--color-copy-white);font-family:var(--font-mono);font-size:13px;letter-spacing:.1em;padding:13px 22px;text-transform:uppercase">登机升舱 ↗</a>
      </div>
    </div>
  </div>
</Shell>
