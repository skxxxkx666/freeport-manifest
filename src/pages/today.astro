---
import Shell from "../components/Shell.astro";
import Stamp from "../components/Stamp.astro";
import TearLine from "../components/TearLine.astro";
import SubscriptionCard from "../components/islands/SubscriptionCard.tsx";
import UpdateCountdown from "../components/islands/UpdateCountdown.tsx";
import { latestSub, checkCode, remarkOf } from "../lib/subs";
import { url, waybillNo } from "../lib/waybill";

const sub = await latestSub();
if (!sub) throw new Error("没有任何运单");
const d = sub.data;
const no = waybillNo(d.date, d.serial);

const wbType =
  "font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:clamp(28px,7cqw,56px);letter-spacing:-.02em;line-height:1;white-space:nowrap";
const miniLabel = "font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:.12em;color:#A9A3B2;text-transform:uppercase;margin-bottom:5px";
const th = "text-align:left;padding:9px 12px;border-bottom:1px solid #C9C2CE;font-size:10px;letter-spacing:.12em;color:#A9A3B2;text-transform:uppercase;font-weight:500";
---
<Shell
  title="今日免费 Clash 与 V2Ray 订阅"
  description={`领取今日免费 Clash、Mihomo 与 V2Ray 订阅：${d.nodeCount} 个发布前实测节点，覆盖 ${d.regions.join("、")}，每 12 小时更新。`}
  schema={{
    dateModified: d.testedAt ?? d.issuedAt,
    about: [
      { "@type": "Thing", name: "免费 Clash 订阅" },
      { "@type": "Thing", name: "免费 V2Ray 节点" }
    ]
  }}
>
  <div>
    <div data-rise style="padding:26px 20px 20px;border-bottom:1px solid #C9C2CE">
      <div style="display:flex;flex-wrap:wrap;gap:22px;justify-content:space-between;align-items:flex-start">
        <div style="flex:1 1 280px;min-width:0">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#A9A3B2;text-transform:uppercase;margin-bottom:6px">WAYBILL NO. / 运单号</div>
          <div style="position:relative;margin-bottom:10px">
            <div aria-hidden="true" style={`position:absolute;left:0;top:0;transform:translate(1.5px,1.5px);opacity:.18;color:#2C6E7A;pointer-events:none;${wbType}`}>{no}</div>
            <div style={`position:relative;${wbType}`}>{no}</div>
          </div>
          <div style="display:flex;flex-wrap:wrap;border-top:1px solid #C9C2CE;border-left:1px solid #C9C2CE;max-width:520px">
            <div style="flex:1 1 150px;min-width:0;padding:9px 11px;border-right:1px solid #C9C2CE;border-bottom:1px solid #C9C2CE">
              <div style={miniLabel}>ISSUED / 签发时间</div>
              <div style="font-family:'IBM Plex Mono',monospace;font-size:14px">{d.date} {d.issuedAt.slice(11, 16)}</div>
            </div>
            <div style="flex:1 1 150px;min-width:0;padding:9px 11px;border-right:1px solid #C9C2CE;border-bottom:1px solid #C9C2CE">
              <div style={miniLabel}>NEXT ISSUE / 下次更新</div>
              <UpdateCountdown client:idle />
            </div>
          </div>
        </div>
        <Stamp size={108} date={d.date} rotate={-6} />
      </div>
    </div>

    <div data-rise>
      <SubscriptionCard
        client:load
        clash={d.clash}
        v2ray={d.v2ray}
        nodeCount={d.nodeCount}
        regions={d.regions}
        protocols={d.protocols}
        checkCode={checkCode(d.date, d.serial)}
        remark={remarkOf(d)}
        date={d.date}
        revealSeconds={3}
      />
    </div>

    {d.breakdown && d.breakdown.length > 0 && (
      <div data-rise style="padding:20px;border-bottom:1px solid #C9C2CE">
        <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#A9A3B2;text-transform:uppercase;margin-bottom:10px">BREAKDOWN / 节点明细</div>
        <div style="overflow-x:auto;border:1px solid #C9C2CE">
          <table style="width:100%;min-width:420px;font-family:'IBM Plex Mono',monospace;font-size:13px;border-collapse:collapse">
            <thead>
              <tr style="background:#F1EFE9">
                <th style={th}>region</th>
                <th style={th + ";border-left:1px solid #C9C2CE"}>protocol</th>
                <th style={th + ";border-left:1px solid #C9C2CE;text-align:right"}>count</th>
              </tr>
            </thead>
            <tbody>
              {d.breakdown.map((r, i) => (
                <tr style={`background:${i % 2 ? "rgba(222,231,241,.3)" : "transparent"}`}>
                  <td style="padding:8px 12px;border-bottom:1px solid #E2DEE5;letter-spacing:.06em">{r.region}</td>
                  <td style="padding:8px 12px;border-bottom:1px solid #E2DEE5;border-left:1px solid #C9C2CE;color:#6B6478">{r.protocol}</td>
                  <td style="padding:8px 12px;border-bottom:1px solid #E2DEE5;border-left:1px solid #C9C2CE;text-align:right">{r.count}</td>
                </tr>
              ))}
              <tr style="background:#F1EFE9">
                <td style="padding:8px 12px;font-size:10px;letter-spacing:.12em;color:#A9A3B2;text-transform:uppercase">total</td>
                <td style="padding:8px 12px;border-left:1px solid #C9C2CE"></td>
                <td style="padding:8px 12px;border-left:1px solid #C9C2CE;text-align:right;font-weight:600">{d.nodeCount}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    )}

    <div data-rise><TearLine /></div>

    <div data-rise style="padding:4px 20px 30px">
      <div style="border:1px solid #C9C2CE;padding:16px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between">
        <div style="flex:1 1 260px;min-width:0">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#1258D8;text-transform:uppercase;margin-bottom:7px">BOARDING PASS / 登机联</div>
          <p style="margin:0;font-size:14.5px;line-height:1.7;color:#2A2333;text-wrap:pretty">
            免费联够用,但线路混杂、随时失效;要稳定的 CN2 / 9929 / CMI 与流媒体、AI 应用,登机联从 ¥9.90 起。
          </p>
        </div>
        <a href={url("upgrade")} style="flex:0 0 auto;border:1px solid #1258D8;background:#1258D8;color:#FBFAF7;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.1em;padding:13px 22px;text-transform:uppercase">登机升舱 ↗</a>
      </div>
    </div>
  </div>
</Shell>
