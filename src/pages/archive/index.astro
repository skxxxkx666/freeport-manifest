---
import Shell from "../../components/Shell.astro";
import ArchiveFilter from "../../components/ArchiveFilter.astro";
import { allSubs } from "../../lib/subs";
import { pageUrl } from "../../lib/waybill";

const subs = await allSubs();
const stubs = subs.map((s) => ({
  date: s.data.date,
  serial: s.data.serial,
  nodeCount: s.data.nodeCount,
  regions: s.data.regions,
  // 当天那一行此前与 15 张过期存根在背景、字重、结构上完全一致,
  // 用户无法在列表层面分辨哪一张还能用。
  current: s.data.expired === false,
  href: pageUrl(`archive/${s.data.date}`)
}));
---
<Shell
  title="免费订阅往期存根"
  description="按日期查看舱单 MANIFEST 的免费 Clash、Mihomo 与 V2Ray 订阅历史存根；旧链接仅供记录，请使用今日订阅。"
  schema={{ "@type": "CollectionPage" }}
>
  <div style="background:var(--color-copy-blue)">
    <div style="padding:26px 20px 18px">
      <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;color:var(--color-ink-faint);text-transform:uppercase;margin-bottom:6px">ARCHIVE / 往期存根</div>
      {/* 套印错位:与首页、升舱页、FAQ 页统一 */}
      <div style="position:relative;margin-bottom:8px">
        <div aria-hidden="true" style="position:absolute;left:0;top:0;transform:translate(1.5px,1.5px);opacity:.18;color:var(--color-misprint);pointer-events:none;font-family:var(--font-display);font-weight:700;font-size:clamp(26px,2.8cqw,38px);letter-spacing:.04em">往期存根</div>
        <h1 style="position:relative;margin:0;font-family:var(--font-display);font-weight:700;font-size:clamp(26px,2.8cqw,38px);letter-spacing:.04em">往期存根</h1>
      </div>
      <p style="margin:0;max-width:40em;font-size:15px;line-height:1.75;color:var(--color-ink-soft);text-wrap:pretty">
        每日 04:17 与 16:17 更新的运单按日期留档。存根链接保留可查,但不再维护,请以今日舱单为准。
      </p>
    </div>
    <div>
      <ArchiveFilter stubs={stubs} />
    </div>
  </div>
</Shell>
