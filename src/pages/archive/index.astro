---
import Shell from "../../components/Shell.astro";
import ArchiveFilter from "../../components/islands/ArchiveFilter.tsx";
import { allSubs } from "../../lib/subs";
import { url } from "../../lib/waybill";

const subs = await allSubs();
const stubs = subs.map((s) => ({
  date: s.data.date,
  serial: s.data.serial,
  nodeCount: s.data.nodeCount,
  regions: s.data.regions,
  href: url(`archive/${s.data.date}`)
}));
---
<Shell
  title="免费订阅往期存根"
  description="按日期查看舱单 MANIFEST 的免费 Clash、Mihomo 与 V2Ray 订阅历史存根；旧链接仅供记录，请使用今日订阅。"
  schema={{ "@type": "CollectionPage" }}
>
  <div style="background:#DEE7F1">
    <div data-rise style="padding:26px 20px 18px">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#A9A3B2;text-transform:uppercase;margin-bottom:6px">ARCHIVE / 往期存根</div>
      <h1 style="margin:0 0 8px;font-family:'Smiley Sans','Archivo Narrow','PingFang SC',sans-serif;font-weight:700;font-size:clamp(26px,4.4cqw,36px);letter-spacing:.04em">往期存根</h1>
      <p style="margin:0;max-width:40em;font-size:15px;line-height:1.75;color:#6B6478;text-wrap:pretty">
        每日 04:00 与 16:00 更新的运单按日期留档。存根链接保留可查,但不再维护,请以今日舱单为准。
      </p>
    </div>
    <div data-rise>
      <ArchiveFilter client:visible stubs={stubs} />
    </div>
  </div>
</Shell>
