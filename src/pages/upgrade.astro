---
import Shell from "../components/Shell.astro";
import CompareTable from "../components/CompareTable.astro";
import PlanCards from "../components/PlanCards.astro";
import CopyCode from "../components/CopyCode.astro";

const label = "font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;color:var(--color-ink-faint);text-transform:uppercase;margin-bottom:12px";
const title = "font-family:var(--font-display);font-weight:700;font-size:clamp(26px,2.8cqw,38px);letter-spacing:.04em;line-height:1.05";
---
<Shell
  title="免费节点与稳定机场线路对比"
  description="对比公开免费 Clash、V2Ray 节点与 FreedomPort 自建 CN2、9929、CMI 稳定线路，了解适用场景、维护方式和套餐区别。"
>
  <div>
    <div style="padding:28px 20px 22px;border-bottom:1px solid var(--color-rule)">
      <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;color:var(--color-ink-faint);text-transform:uppercase;margin-bottom:6px">UPGRADE / 登机升舱</div>
      <div style="position:relative;margin-bottom:12px">
        <div aria-hidden="true" style={`position:absolute;left:0;top:0;transform:translate(1.5px,1.5px);opacity:.18;color:var(--color-misprint);pointer-events:none;${title}`}>登机升舱</div>
        <h1 style={`position:relative;margin:0;color:var(--color-port-blue);${title}`}>登机升舱</h1>
      </div>
      <p style="margin:0;max-width:40em;font-size:15px;line-height:1.75;color:var(--color-ink);text-wrap:pretty">
        免费联是公开来源的聚合,能用但不可控。登机联是自由港的自建线路,持续维护。以下是两者的实际差别。
      </p>
    </div>

    <div style="padding:22px 20px 26px;border-bottom:1px solid var(--color-rule)">
      <h2 style={label + ";margin-top:0;font-weight:400"}>COMPARISON / 两联对照</h2>
      <CompareTable />
    </div>

    {/* 套餐 + 折扣码 + 登机入口是同一条转化动作,合成一个账带色块;
        上方的两联对照留在正本联,形成「说明 → 行动」的色调分层。 */}
    <div style="padding:22px 20px 26px;background:var(--color-band)">
      <h2 style={label + ";margin-top:0;font-weight:400"}>FARES / 四档舱位</h2>
      <PlanCards accentTop={true} />
    </div>

    <div style="padding:22px 20px 26px;background:var(--color-band)">
      <h2 style={label + ";margin-top:0;font-weight:400"}>DISCOUNT / 折扣码</h2>
      <CopyCode />
    </div>

    <div style="padding:22px 20px 30px;background:var(--color-band)">
      <h2 style={label + ";margin-top:0;font-weight:400"}>BOARDING / 登机入口</h2>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        <a href="https://cn.freedomport.cc" target="_blank" rel="noopener" class="wb-btn-port" style="border:1px solid var(--color-port-blue);background:var(--color-port-blue);color:var(--color-copy-white);font-family:var(--font-mono);font-size:13px;letter-spacing:.1em;padding:14px 24px;text-transform:uppercase">前往自由港官网 ↗</a>
        <a href="https://t.me/FreedomPort1" target="_blank" rel="noopener" class="wb-btn-port-ghost" style="border:1px solid var(--color-port-blue);background:transparent;color:var(--color-port-blue);font-family:var(--font-mono);font-size:13px;letter-spacing:.1em;padding:14px 24px;text-transform:uppercase">加入 TELEGRAM 群组</a>
      </div>
      <div style="margin-top:12px;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.08em;color:var(--color-ink-soft)">使用教程 WIKI.FREEDOMPORT.CC</div>
    </div>
  </div>
</Shell>
