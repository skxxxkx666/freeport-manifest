---
import Shell from "../components/Shell.astro";
import FaqList from "../components/FaqList.astro";
import { FAQ } from "../lib/faq";
---
<Shell
  title="免费 Clash 与 V2Ray 订阅常见问题"
  description="免费 Clash、Mihomo、V2Ray 订阅常见问题：更新频率、节点失效、v2rayN、Shadowrocket、Clash Verge 导入与安全说明。"
  schema={{
    "@type": "FAQPage",
    mainEntity: FAQ.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: {
        "@type": "Answer",
        text: answer
      }
    }))
  }}
>
  <div>
    <div style="padding:26px 20px 20px;border-bottom:1px solid var(--color-rule)">
      <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;color:var(--color-ink-faint);text-transform:uppercase;margin-bottom:6px">FAQ / 常见问题</div>
      {/* 套印错位:此前只有首页与升舱页的 h1 有,这两页悄悄退出了签名装置 */}
      <div style="position:relative">
        <div aria-hidden="true" style="position:absolute;left:0;top:0;transform:translate(1.5px,1.5px);opacity:.18;color:var(--color-misprint);pointer-events:none;font-family:var(--font-display);font-weight:700;font-size:clamp(26px,2.8cqw,38px);letter-spacing:.04em">常见问题</div>
        <h1 style="position:relative;margin:0;font-family:var(--font-display);font-weight:700;font-size:clamp(26px,2.8cqw,38px);letter-spacing:.04em">常见问题</h1>
      </div>
    </div>
    <div>
      <FaqList items={FAQ} />
    </div>
  </div>
</Shell>
