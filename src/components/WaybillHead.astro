---
// 运单号大字 + 套印错位(§7:只在运单号与主标题上用)
interface Props { no: string; label?: string; muted?: boolean; }
const { no, label = "WAYBILL NO. / 运单号", muted = false } = Astro.props;
const type =
  "font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:clamp(28px,7cqw,56px);letter-spacing:-.02em;line-height:1;white-space:nowrap";
---
<div>
  <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;color:#A9A3B2;text-transform:uppercase;margin-bottom:6px">
    {label}
  </div>
  <div style="position:relative;margin-bottom:14px">
    <div aria-hidden="true" style={`position:absolute;left:0;top:0;transform:translate(1.5px,1.5px);opacity:.18;color:#2C6E7A;pointer-events:none;${type}`}>
      {no}
    </div>
    <div style={`position:relative;${type}${muted ? ";color:#6B6478" : ""}`}>{no}</div>
  </div>
</div>
