---
const rows: [string, string, string][] = [
  ["节点来源", "公开聚合,不可控", "自建 + BGP 专线优化"],
  ["线路类型", "混杂,多为公共中转", "CN2 / 9929 / CMI,高档含原生节点"],
  ["稳定性", "随时失效,无保障", "持续维护,持续更新"],
  ["速度", "高峰期拥堵", "智能路由,低延迟"],
  ["流媒体", "看运气", "Netflix / Disney+ / YouTube"],
  ["AI 应用", "多数被风控", "ChatGPT / Claude / Midjourney"],
  ["设备数", "无限制(但也没得保障)", "按套餐 1–5 台"],
  ["Telegram", "常断连", "专门优化"],
  ["价格", "免费", "¥9.90 起"]
];
const th =
  "text-align:left;padding:10px 12px;border-bottom:1px solid #C9C2CE;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;font-weight:500";
---
<div style="overflow-x:auto;border:1px solid #C9C2CE">
  <table style="width:100%;min-width:540px;font-size:14px;border-collapse:collapse">
    <thead>
      <tr style="background:#F1EFE9">
        <th style={th + ";color:#A9A3B2;width:26%"}>ITEM</th>
        <th style={th + ";color:#A9A3B2;border-left:1px solid #C9C2CE"}>FREE / 免费联(本站)</th>
        <th style={th + ";color:#1258D8;border-left:1px solid #C9C2CE"}>BOARDING / 登机联(自由港)</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(([item, free, paid], i) => (
        <tr style={`background:${i % 2 ? "rgba(222,231,241,.3)" : "transparent"}`}>
          <td style="padding:9px 12px;border-bottom:1px solid #E2DEE5;font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:.04em;color:#6B6478">{item}</td>
          <td style="padding:9px 12px;border-bottom:1px solid #E2DEE5;border-left:1px solid #C9C2CE">{free}</td>
          <td style="padding:9px 12px;border-bottom:1px solid #E2DEE5;border-left:1px solid #C9C2CE;color:#0B3A93">{paid}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
