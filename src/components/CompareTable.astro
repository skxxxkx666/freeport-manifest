---
// 结构与配色走 theme.css 的 .wb-compare —— 窄屏拆卡需要媒体查询,内联样式装不下。
// data-th 在拆卡后补回列名,否则读者看不出哪一格是免费联、哪一格是登机联。
const FREE = "FREE / 免费联(本站)";
const PAID = "BOARDING / 登机联(自由港)";
const rows: [string, string, string][] = [
  ["节点来源", "公开聚合,不可控", "自建 + BGP 专线优化"],
  ["线路类型", "混杂,多为公共中转", "CN2 / 9929 / CMI,高档含原生节点"],
  ["稳定性", "随时失效,无保障", "持续维护,持续更新"],
  ["速度", "高峰期拥堵", "智能路由,低延迟"],
  ["流媒体", "看运气", "Netflix / Disney+ / YouTube"],
  ["AI 应用", "多数被风控", "ChatGPT / Claude / Midjourney"],
  ["设备数", "无限制(但也没得保障)", "按套餐 1–5 台"],
  ["Telegram", "常断连", "专门优化"],
  ["价格", "免费", "¥9.90 起"]
];
---
<div class="wb-compare">
  <table>
    <thead>
      <tr>
        <th style="width:26%">ITEM</th>
        <th>{FREE}</th>
        <th>{PAID}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(([item, free, paid]) => (
        <tr>
          <td>{item}</td>
          <td data-th={FREE}>{free}</td>
          <td data-th={PAID}>{paid}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
