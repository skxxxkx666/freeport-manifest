---
import "../styles/theme.css";
import { url } from "../lib/waybill";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
}
const {
  title,
  description = "舱单 MANIFEST 每 12 小时聚合并实测公开免费节点，提供 Clash、Mihomo 与 V2Ray 订阅。",
  noindex = false,
  schema = {}
} = Astro.props;
const siteName = "舱单 MANIFEST";
const documentTitle = `${title}｜${siteName}`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, site);
canonicalUrl.search = "";
canonicalUrl.hash = "";
const canonical = canonicalUrl.href;
const siteUrl = new URL(import.meta.env.BASE_URL, site).href;
const socialImage = new URL(url("og-card.png"), site).href;
const sitemapUrl = new URL(url("sitemap-index.xml"), site).href;
const robots = noindex
  ? "noindex,follow"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: siteName,
      alternateName: ["免费订阅舱单", "MANIFEST"],
      description:
        "每 12 小时更新的免费 Clash、Mihomo 与 V2Ray 节点订阅公益站。",
      inLanguage: "zh-CN"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: documentTitle,
      description,
      inLanguage: "zh-CN",
      isPartOf: { "@id": `${siteUrl}#website` },
      ...schema
    }
  ]
}).replace(/</g, "\\u003c");

const nav = [
  { label: "首页", path: "", code: "/" },
  { label: "今日舱单", path: "today", code: "/today" },
  { label: "往期", path: "archive", code: "/archive" },
  { label: "升舱", path: "upgrade", code: "/upgrade", blue: true },
  { label: "FAQ", path: "faq", code: "" }
];
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL, "").replace(/\/$/, "");
const active = (p: string) => here === p || (p !== "" && here.startsWith(p));

const noise =
  "url(\"data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22/></filter><rect width=%22160%22 height=%22160%22 filter=%22url(%23n)%22/></svg>\")";
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{documentTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={robots} />
  <meta name="theme-color" content="#FBFAF7" />
  <meta name="color-scheme" content="light" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" type="application/xml" href={sitemapUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={documentTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:secure_url" content={socialImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="舱单 MANIFEST 免费 Clash、Mihomo 与 V2Ray 订阅" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={documentTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content="舱单 MANIFEST 免费订阅舱单" />
  <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
  <link rel="apple-touch-icon" sizes="180x180" href={url("apple-touch-icon.png")} />
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Archivo Narrow 已移出下载:它只是 Smiley Sans 的回退,而子集实测覆盖全部
       52 个拉丁字母与 10 个数字(见 DESIGN.md),因此一个字形都不会渲染。
       字体名保留在 font-family 栈里 —— 本机装了就用,不装也不产生请求。
       IBM Plex Mono 500 全站仅 2 处表头使用,已并入 400。7 个字重文件降到 2 个。 -->
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div style="min-height:100vh;background:var(--color-desk);position:relative">
    <div
      aria-hidden="true"
      style={`position:fixed;inset:0;pointer-events:none;z-index:60;mix-blend-mode:multiply;opacity:.07;background-image:${noise}`}
    >
    </div>

    <div class="wb-head">
      <div class="wb-head-in">
        <a href={url("")} class="wb-brand">
          <span style="font-family:var(--font-display);font-weight:700;font-size:21px;letter-spacing:.06em">舱单</span>
          <span style="width:1px;align-self:stretch;background:var(--color-rule)"></span>
          <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;color:var(--color-ink-soft);text-transform:uppercase">MANIFEST</span>
        </a>
        <nav class="wb-nav">
          {nav.map((n) => (
            <a
              href={url(n.path)}
              style={`border-bottom-color:${active(n.path) ? (n.blue ? "var(--color-port-blue)" : "var(--color-stamp)") : "transparent"};color:${n.blue ? "var(--color-port-blue)" : "var(--color-ink)"}`}
            >
              {n.label}{" "}
              {/* 路径码统一用次墨。--color-port-blue-f 自带注释「只在已是官方蓝的元素
                  内部当次级文字」,而这里是纸底,实测 3.82:1,是 token 用在自己禁止的位置。 */}
              <span class="wb-nav-code" style="color:var(--color-ink-soft)">{n.code}</span>
            </a>
          ))}
          <a href="https://wiki.freedomport.cc/" target="_blank" rel="noopener" style="color:var(--color-ink)">
            教程 <span class="wb-nav-code" style="color:var(--color-ink-soft)">WIKI</span> <span style="color:var(--color-ink-soft)">↗</span>
          </a>
        </nav>
      </div>
    </div>

    <div class="wb-desk">
      <div class="wb-sheet">
        <div aria-hidden="true" style="height:14px;background:var(--color-desk);background-image:repeating-radial-gradient(circle at 9px 7px, var(--color-desk) 0 3px, var(--color-copy-white) 3px 9px);background-size:18px 14px;border-bottom:1px solid var(--color-rule)"></div>

        <slot />

        {/* 底部齿孔。此前只有顶部有,单据看起来是从纸卷上撕下但没撕断。
            两端都打孔,它才是一张完整的、可归档的单据;页脚随之读作存根边。 */}
        <div aria-hidden="true" style="height:14px;background:var(--color-desk);background-image:repeating-radial-gradient(circle at 9px 7px, var(--color-desk) 0 3px, var(--color-copy-white) 3px 9px);background-size:18px 14px;border-top:1px solid var(--color-rule)"></div>

        <footer style="border-top:1px solid var(--color-rule);background:var(--color-band);padding:22px 20px 26px">
          <div style="display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between">
            <div style="display:flex;align-items:center;gap:10px">
              <span style="font-family:var(--font-display);font-weight:700;font-size:17px;letter-spacing:.06em">舱单</span>
              <span style="width:1px;height:16px;background:var(--color-rule)"></span>
              <span style="font-family:var(--font-mono);font-size:9.5px;letter-spacing:.18em;color:var(--color-ink-soft);text-transform:uppercase">MANIFEST</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:18px;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.1em;color:var(--color-ink-soft);text-transform:uppercase">
              <a href={url("archive")}>/ARCHIVE 往期存根</a>
              <a href={url("upgrade")}>/UPGRADE 登机升舱</a>
              <a href={url("faq")}>/FAQ 常见问题</a>
              <a href="https://t.me/FreedomPort1" target="_blank" rel="noopener">TELEGRAM 群组 ↗</a>
              <a href="https://wiki.freedomport.cc/" target="_blank" rel="noopener">WIKI 使用教程 ↗</a>
            </div>
          </div>
          <div style="margin-top:16px;border-top:1px dashed var(--color-rule);padding-top:12px;font-family:var(--font-mono);font-size:10.5px;line-height:1.85;color:var(--color-ink-soft);max-width:62em">
            免责声明:本站仅聚合公开来源的网络加速配置,用于跨境访问的技术测试与国际线路连通性验证。不提供可用性、速度或存活时间的任何保障,亦不对第三方节点的行为负责。请遵守所在地法律法规。
          </div>
        </footer>
      </div>
    </div>
  </div>

  {/* 滚动入场已移除,理由见 DESIGN.md 的 The Still Paper Rule。
      要点:每个区块同一个淡入上移是公认反模式,且原实现由 JS 先设 opacity:0
      再靠 IntersectionObserver 揭开,内容默认隐藏 —— 打印、Ctrl+F 跳转、
      IO 回调抛错都会让整段永远不显示。
      属性保留,现在只是顶层区块的标记,无 JS 无 CSS 读取它。 */}
</body>
</html>
