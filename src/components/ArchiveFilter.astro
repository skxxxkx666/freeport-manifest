---
import { monthLabel, monthOf, waybillNo } from "../lib/waybill";

export interface Stub {
  date: string;
  serial: string;
  nodeCount: number;
  regions: string[];
  current?: boolean;
  href: string;
}

const { stubs } = Astro.props as { stubs: Stub[] };
const months = [...new Set(stubs.map((stub) => monthOf(stub.date)))];
const groups = months.map((month) => ({
  month,
  rows: stubs.filter((stub) => monthOf(stub.date) === month)
}));
---

<section data-archive-filter aria-label="按月份筛选往期存根">
  <div style="display:flex;flex-wrap:wrap;gap:1px;background:var(--color-rule);border:1px solid var(--color-rule);width:fit-content;margin:0 20px 18px">
    {["all", ...months].map((month) => (
      <button
        type="button"
        class="wb-tab"
        data-archive-filter-button={month}
        aria-pressed={month === "all" ? "true" : "false"}
        style={`appearance:none;border:0;background:${month === "all" ? "var(--color-ink)" : "var(--color-copy-white)"};color:${month === "all" ? "var(--color-copy-white)" : "var(--color-ink-soft)"};font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;padding:9px 15px;min-height:44px;cursor:pointer`}
      >
        {month === "all" ? "全部" : month}
      </button>
    ))}
  </div>

  <div data-archive-filter-status class="wb-sr-only" role="status" aria-live="polite"></div>

  {groups.map((group) => (
    <section data-archive-month={group.month}>
      <h2 style="margin:0;display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:10px 20px;background:var(--color-copy-blue-d);border-bottom:1px solid var(--color-rule);border-top:1px solid var(--color-rule);font-family:var(--font-mono);font-size:10.5px;font-weight:400;letter-spacing:.14em;color:var(--color-ink);text-transform:uppercase">
        <span>{monthLabel(group.month)}</span>
        <span style="color:var(--color-ink-faint)">{group.rows.length} 份</span>
      </h2>
      {group.rows.map((stub, i) => (
        <a
          href={stub.href}
          class="wb-row"
          style={`display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 18px;border-bottom:1px solid var(--color-rule);background:${i % 2 ? "rgba(251,250,247,.5)" : "transparent"};color:var(--color-ink);padding:11px 20px`}
        >
          <span style="flex:1 1 200px;font-family:var(--font-mono);font-weight:600;font-size:19px;letter-spacing:-.01em">{waybillNo(stub.date, stub.serial)}</span>
          <span style="flex:0 0 96px;font-family:var(--font-mono);font-size:12px;color:var(--color-ink-soft);letter-spacing:.04em">{stub.date}</span>
          <span style="flex:0 0 68px;text-align:right;font-family:var(--font-mono);font-size:12px;letter-spacing:.04em">{stub.nodeCount} PCS</span>
          <span style="flex:0 0 170px;font-family:var(--font-mono);font-size:12px;color:var(--color-ink-soft);letter-spacing:.08em">{stub.regions.join(" ")}</span>
          <span style="flex:0 0 auto;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.14em;color:var(--color-ink-soft);text-transform:uppercase">
            {stub.current ? "当前生效 →" : "查看 →"}
          </span>
        </a>
      ))}
    </section>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-archive-filter]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-archive-filter-button]")];
    const groups = [...root.querySelectorAll<HTMLElement>("[data-archive-month]")];
    const status = root.querySelector<HTMLElement>("[data-archive-filter-status]");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const month = button.dataset.archiveFilterButton ?? "all";
        for (const item of buttons) {
          const active = item === button;
          item.setAttribute("aria-pressed", String(active));
          item.style.background = active ? "var(--color-ink)" : "var(--color-copy-white)";
          item.style.color = active ? "var(--color-copy-white)" : "var(--color-ink-soft)";
        }
        let shown = 0;
        for (const group of groups) {
          const visible = month === "all" || group.dataset.archiveMonth === month;
          group.hidden = !visible;
          if (visible) shown += group.querySelectorAll(":scope > a").length;
        }
        if (status) status.textContent = `已显示 ${shown} 份存根`;
      });
    }
  });
</script>
